{
  "schema_version": "1.0",
  "palette_version": "paperforge-muted-v1",
  "surface": "manuscript",
  "neutrals": {
    "background": "#FFFFFF",
    "text": "#2F3437",
    "grid": "#D9DEE7",
    "reference": "#7A828A",
    "error_bar": "#2F3437",
    "missing": "#B8BEC6"
  },
  "categorical_tokens": {
    "blue": "#4C78A8",
    "teal": "#5AA6A6",
    "sage": "#7A9E7E",
    "gold": "#D8A657",
    "coral": "#D98373",
    "slate": "#8A95A5",
    "purple": "#8E7CC3"
  },
  "semantic_roles": {
    "baseline": "#8A95A5",
    "primary_method": "#4C78A8",
    "secondary_method": "#8E7CC3",
    "ablation": "#5AA6A6",
    "supporting_group": "#7A9E7E",
    "warning_or_adverse": "#D98373",
    "highlight": "#D8A657"
  },
  "fixed_entities": {},
  "encodings": {
    "color": "method_or_single_declared_role",
    "marker": "dataset_or_cohort",
    "line_style": "setting_or_horizon",
    "lightness": "ordered_severity",
    "uncertainty": "charcoal_or_same_hue_low_alpha"
  },
  "panel_labels": {
    "anchor": "axes_upper_left",
    "offset_points": [-8, 4],
    "case": "venue-defined",
    "default_case_when_unspecified": "lowercase",
    "font_size_pt_at_final_size": "venue-defined-default-8",
    "font_weight": "bold",
    "font_style": "upright",
    "same_case_and_size_across_manuscript": true,
    "horizontal_alignment": "right",
    "vertical_alignment": "bottom",
    "minimum_left_gap_points": 4,
    "maximum_top_gap_points": 10,
    "forbid_subplot_title": true,
    "rendered_geometry_audit": "required"
  },
  "heatmap_layout": {
    "data_axes_center_tolerance_fraction": 0.02,
    "comparable_axes_width_tolerance_fraction": 0.01,
    "symmetric_outer_margins": true,
    "shared_row_labels": true,
    "colorbar_must_not_shrink_axes_unequally": true,
    "word_fixed_canvas": true,
    "word_zero_crop": true
  },
  "caption_contract": {
    "panel_case": "venue-defined",
    "default_case_when_unspecified": "lowercase",
    "same_case_across_manuscript": true,
    "require_one_to_one_panel_mapping": true,
    "require_panel_order_in_caption": true,
    "caption_stored_in": "manuscript_or_latex_source",
    "standalone_generated_caption_markdown": false
  },
  "figures": [],
  "export": {
    "vector_master": true,
    "png_dpi": 600,
    "white_background": true,
    "final_size_visual_review": "pending"
  }
}
